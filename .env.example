# Copiá este archivo como ".env" (sin .example) y completá los valores.
# .env está en .gitignore: nunca se sube al repo.

# Clave del panel /admin. Larga y distinta a cualquier otra.
ADMIN_PASSWORD=cambiame-por-una-clave-larga

# Cadena aleatoria larga que firma la cookie de sesión. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-cadena-aleatoria

# Opcional: dónde guardar la base SQLite (por defecto instance/instituto.db).
# Útil en hostings con disco persistente montado en otra ruta.
# DB_PATH=/var/data/instituto.db

# En el hosting (con HTTPS) poné 1: la cookie de sesión solo viaja cifrada.
# En tu máquina dejalo en 0 o borrá la línea.
SECURE_COOKIES=0

# Opcional: carpeta para las imágenes subidas desde el panel.
# Por defecto queda al lado de la base (instance/uploads/).
# UPLOAD_DIR=/var/data/uploads

# Opcional: aviso por mail cuando llega un comentario, con links para
# aprobarlo o borrarlo. Con Gmail hace falta una "contraseña de aplicación"
# (ver DEPLOY.md, sección 5b). Si SMTP_USER o SMTP_PASSWORD faltan, no se
# manda nada y todo lo demás funciona igual.
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación-de-16-letras
# NOTIFY_EMAIL=quien-recibe@ejemplo.com
# SITE_URL=https://institutoenergia.pythonanywhere.com

# Moderación de comentarios: "post" (por defecto) = se publican al instante y
# el equipo borra lo que no corresponde; "pre" = quedan pendientes hasta que
# alguien los aprueba (desde el panel, el post o el mail de aviso).
# COMMENTS_MODERATION=post

# Anti-spam: comentarios por dirección de internet cada 10 minutos.
# COMMENT_LIMIT_PER_10MIN=15

# Redes sociales del banner: se muestra el ícono de cada red que tenga su
# dirección acá (las que no, no aparecen). Poné las direcciones completas.
# SOCIAL_X=https://x.com/...
# SOCIAL_INSTAGRAM=https://www.instagram.com/...
# SOCIAL_FACEBOOK=https://www.facebook.com/...
# SOCIAL_LINKEDIN=https://www.linkedin.com/company/...
# SOCIAL_YOUTUBE=https://www.youtube.com/@...
# SOCIAL_PINTEREST=https://www.pinterest.com/...
